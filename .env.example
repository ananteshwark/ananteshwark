# ---- Database ----
# Postgres (recommended for production):
# DATABASE_URL=postgresql+psycopg2://cms:cms@localhost:5432/cms
# SQLite (default for local development):
DATABASE_URL=sqlite:///./cms.db

# ---- Auth ----
JWT_SECRET=please-change-me-to-a-long-random-string-32b+
JWT_EXPIRY_MINUTES=480
# Google Sign-In (optional) — OAuth Client ID is public; also settable in Admin Settings
GOOGLE_CLIENT_ID=
# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Claude API (never exposed to the frontend) ----
# Can also be configured at runtime from Admin Settings (stored write-only in DB)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MAX_TOKENS=16000
EXTRACTION_MAX_RETRIES=3

# ---- Folder watcher ----
WATCH_ROOT=./watched
WATCH_ENABLED=true
FILE_STABILITY_SECONDS=3
SUPPORTED_EXTENSIONS=.pdf,.docx,.jpg,.jpeg,.png

# ---- Scheduling (timestamps stored in UTC; display/schedule in Asia/Kolkata) ----
TIMEZONE=Asia/Kolkata
REMINDER_RUN_TIME=08:00

# ---- Email (expiry reminders) ----
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cms-reminders@example.com
SMTP_TLS=false
# true = log emails instead of sending (dev)
EMAIL_DRY_RUN=true

# ---- Google Drive monitoring (optional) ----
# Configured primarily from Admin Settings; this only sets the local staging dir
# where downloaded Drive files are written before ingestion.
GDRIVE_STAGING=./gdrive_staging

# ---- Validation ----
CONFIDENCE_THRESHOLD=0.8

# Frontend base URL (used in reminder email links + CORS)
APP_BASE_URL=http://localhost:5173
