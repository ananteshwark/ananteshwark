# Caddy fronts the whole stack and provisions HTTPS automatically via
# Let's Encrypt (DOMAIN comes from .env through docker-compose).
#
# Routing:
#   /api/*  -> NestJS API (prefix stripped; the API serves routes at /)
#   /*      -> the static web build (nginx inside the web container)

# Optional add-on apps (e.g. the Contract Management System) drop their own
# site blocks here. This glob matches nothing until the contracts overlay
# mounts a file into the directory, so the base deploy is unaffected.
import /etc/caddy/conf.d/*.caddy

{$DOMAIN} {
	encode gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}
}
