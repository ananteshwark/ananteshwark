# Production environment for docker-compose.prod.yml.
#   cp .env.production.example .env   # then edit every REQUIRED value.
# Never commit the resulting .env file.

# ── Required ─────────────────────────────────────────────────────────────────
# Public domain pointing at this server (A/AAAA record). Caddy uses it to
# provision the HTTPS certificate; the API uses it for CORS.
DOMAIN=erp.example.com

# Postgres credentials (the database runs inside the compose stack).
DATABASE_NAME=erp_db
DATABASE_USER=erp_user
DATABASE_PASSWORD=change-me-long-random

# Set to true ONLY when using an external managed Postgres that requires TLS
# (Neon, Supabase, Render PG — see HOSTING_PAAS.md). The bundled compose
# Postgres is local and plaintext, so leave this unset for the VM path.
#DATABASE_SSL=true

# JWT signing secrets — generate each with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-different-openssl-rand-hex-32

# ── Optional ─────────────────────────────────────────────────────────────────
# Token lifetimes.
#JWT_EXPIRATION=15m
#JWT_REFRESH_EXPIRATION=7d

# SMTP for outbound email (password resets, scheduled report delivery).
# Free options: Brevo (300/day) or any provider's SMTP relay. Tenants can
# also configure their own SMTP in-app, which overrides these.
#SMTP_HOST=smtp-relay.brevo.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=no-reply@erp.example.com

# Anthropic API key — enables receipt OCR, CV parsing and the LLM copilot
# planner. Everything degrades gracefully without it.
#ANTHROPIC_API_KEY=

# Set to true to deliver Teams/Slack notifications via incoming webhooks.
#CHANNEL_WEBHOOKS_ENABLED=false

# ── Contract Management System (optional add-on) ─────────────────────────────
# Only needed when running the contracts overlay:
#   docker compose -f docker-compose.prod.yml -f docker-compose.contracts.yml up -d --build
# The CMS runs on its OWN subdomain (own Postgres, own auth). Point a separate
# DNS A record for CONTRACTS_DOMAIN at this same server. See CONTRACTS.md.
#CONTRACTS_DOMAIN=contracts.example.com
#CONTRACTS_DB_PASSWORD=change-me-long-random
#CONTRACTS_JWT_SECRET=change-me-openssl-rand-hex-32
# The CMS uses ANTHROPIC_API_KEY (above) for contract extraction. Optional:
#CONTRACTS_WATCH_ENABLED=false
#CONTRACTS_EMAIL_DRY_RUN=true
#CONTRACTS_TIMEZONE=Asia/Kolkata
